[Unit]
After=network-online.target postgresql.service hdfs-datanode.service
Requires=postgresql.service

[Service]
User=hadoop
WorkingDirectory=/var/lib/hive
Environment=HIVE_HOME=/opt/hive
Environment=HIVE_CONF_DIR=/etc/hive
Environment=HADOOP_HOME=/opt/hadoop
Environment=HADOOP_CONF_DIR=/etc/hadoop
ExecStart=/opt/hive/bin/hive --service metastore
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
