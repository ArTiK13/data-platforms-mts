[Unit]
After=network-online.target hive-metastore.service
Requires=hive-metastore.service

[Service]
User=hadoop
RuntimeDirectory=hive-server2
WorkingDirectory=/var/lib/hive
Environment=HIVE_HOME=/opt/hive
Environment=HIVE_CONF_DIR=/etc/hive
Environment=HADOOP_HOME=/opt/hadoop
Environment=HADOOP_CONF_DIR=/etc/hadoop
ExecStart=/opt/hive/bin/hive --service hiveserver2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
